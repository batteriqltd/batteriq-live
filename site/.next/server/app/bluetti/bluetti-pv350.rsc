1a:T532,{"@context":"https://schema.org","@type":"Product","@id":"https://batteriq.com/bluetti/bluetti-pv350#product","name":"BLUETTI PV350 Solar Panel 350W","url":"https://batteriq.com/bluetti/bluetti-pv350","image":["https://batteriq.com/products/bluetti/bluetti-pv350.jpg"],"description":"The Bluetti PV350 delivers 350W of high-efficiency monocrystalline solar power. Large format for fast charging of AC200PL, AC300, and AC500 systems in Kenya's abundant sunshine.","brand":{"@type":"Brand","name":"BLUETTI"},"category":"Solar Panels","sku":"BLUETTI-PV350","additionalProperty":[{"@type":"PropertyValue","name":"Type","value":"Monocrystalline"},{"@type":"PropertyValue","name":"Power","value":"350W"},{"@type":"PropertyValue","name":"Weight","value":"9.5kg"},{"@type":"PropertyValue","name":"Foldable","value":"Yes"},{"@type":"PropertyValue","name":"Connector","value":"MC4"},{"@type":"PropertyValue","name":"Ip Rating","value":"IP65"},{"@type":"PropertyValue","name":"Efficiency","value":"23.4%"}],"offers":{"@type":"Offer","url":"https://batteriq.com/bluetti/bluetti-pv350","priceCurrency":"KES","price":55000,"priceValidUntil":"2027-11-16","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","seller":{"@type":"Organization","@id":"https://batteriq.com/#organization","name":"Batteriq"}}}1b:T725,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much is the Bluetti PV350 Solar Panel 350W in Kenya?","acceptedAnswer":{"@type":"Answer","text":"The Bluetti PV350 Solar Panel 350W costs KES 55,000 at Batteriq, Kenya's authorised BLUETTI dealer. You can pay instantly with M-Pesa or by Visa/Mastercard at checkout. It is covered by a 24-month warranty."}},{"@type":"Question","name":"Is the Bluetti PV350 Solar Panel 350W available in Nairobi?","acceptedAnswer":{"@type":"Answer","text":"Yes — the Bluetti PV350 Solar Panel 350W is in stock and ready to ship. We deliver across Nairobi and ship nationwide to all 47 counties, and you will get an official eTIMS KRA invoice with your order."}},{"@type":"Question","name":"Does the Bluetti PV350 Solar Panel 350W work with my power station?","acceptedAnswer":{"@type":"Answer","text":"It connects to compatible EcoFlow and BLUETTI power stations for solar charging. Send us your power station model on WhatsApp and we will confirm the right cable and setup before you buy. It is covered by a 24-month warranty."}},{"@type":"Question","name":"What can the BLUETTI PV350 Solar Panel 350W run in a Kenyan home?","acceptedAnswer":{"@type":"Answer","text":"A solar panel charges a power station rather than running appliances directly. In full sun the BLUETTI PV350 Solar Panel 350W produces up to 350 W, which tops up a power station during the day so it can run your lights, Wi-Fi, TV and fridge through a KPLC outage."}},{"@type":"Question","name":"Which power stations work with the BLUETTI PV350 Solar Panel 350W?","acceptedAnswer":{"@type":"Answer","text":"Any power station whose solar input accepts at least 350 W and the MC4 connector can use it. Message us on WhatsApp with your model and we will confirm the right cable."}}]}20:{"size":20}
