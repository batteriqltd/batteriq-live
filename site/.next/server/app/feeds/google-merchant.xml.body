<item><g:id>5010201023</g:id><g:title>EcoFlow WAVE 2 Smart Portable Air Conditioner</g:title><g:description>The EcoFlow WAVE 2 is the world&apos;s most portable air conditioner designed for use with EcoFlow power stations. Heat and cool anywhere in Kenya — perfect for outdoor events, camping, and backup home cooling.</g:description><g:link>https://batteriq.com/ecoflow/wave-2-portable-air-conditioner</g:link><g:image_link>https://batteriq.com/products/ecoflow/wave-2-portable-air-conditioner.jpg</g:image_link><g:additional_image_link>https://batteriq.com/products/ecoflow/wave-2-portable-air-conditioner1.jpg</g:additional_image_link><g:availability>in_stock</g:availability><g:price>149469.00 KES</g:price><g:brand>EcoFlow</g:brand><g:condition>new</g:condition><g:mpn>5010201023</g:mpn><g:identifier_exists>no</g:identifier_exists><g:product_type>EcoFlow &gt; Appliances</g:product_type></item>
