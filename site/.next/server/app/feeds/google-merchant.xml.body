<item><g:id>5009001005</g:id><g:title>EcoFlow GLACIER Portable Fridge Freezer</g:title><g:description>The EcoFlow GLACIER is a portable fridge-freezer that runs efficiently on EcoFlow power stations. Dual zone: one fridge, one freezer. Ideal for Kenyan camping, overlanding, and home use during power cuts.</g:description><g:link>https://batteriq.com/ecoflow/glacier-portable-fridge-freezer</g:link><g:image_link>https://batteriq.com/products/ecoflow/glacier-portable-fridge-freezer.jpg</g:image_link><g:additional_image_link>https://batteriq.com/products/ecoflow/glacier-portable-fridge-freezer1.jpg</g:additional_image_link><g:additional_image_link>https://batteriq.com/products/ecoflow/glacier-portable-fridge-freezer2.jpg</g:additional_image_link><g:additional_image_link>https://batteriq.com/products/ecoflow/glacier-portable-fridge-freezer3.jpg</g:additional_image_link><g:availability>in_stock</g:availability><g:price>149469.00 KES</g:price><g:brand>EcoFlow</g:brand><g:condition>new</g:condition><g:mpn>5009001005</g:mpn><g:identifier_exists>no</g:identifier_exists><g:product_type>EcoFlow &gt; Appliances</g:product_type></item>
