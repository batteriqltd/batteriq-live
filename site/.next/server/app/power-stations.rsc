nya for KES 127,000 from Batteriq, an authorised Bluetti dealer. Pay by M-Pesa or card. Genuine stock with local warranty support.","schema_rating":4.8,"schema_review_count":0,"created_at":"2026-08-06T06:41:12.669284+00:00","updated_at":"2026-10-09T14:17:35.274632+00:00","discount_label":null,"discount_start":null,"discount_end":null,"low_stock_threshold":3,"featured_image":"https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/0a80a2e6-5045-49ab-a8b9-af95be4c79b9-1785998476446.jpeg"},{"id":"a7f1c670-d0b1-4dd5-b4b8-d1a2ba3369ab","sku":"10Mblack cable","brand":"EcoFlow","category":"Power Stations","subcategory":null,"name":"10Mblack cable","slug":"10mblack-cable","description":"10Mblack cable","specs":{},"images":["https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/a7f1c670-d0b1-4dd5-b4b8-d1a2ba3369ab-1785160731434.png"],"price_kes":2000,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":999,"featured":false,"sort_order":0,"meta_title":null,"meta_description":null,"schema_rating":4.8,"schema_review_count":0,"created_at":"2026-07-27T13:58:50.367555+00:00","updated_at":"2026-07-27T13:58:52.109021+00:00","discount_label":null,"discount_start":null,"discount_end":null,"low_stock_threshold":3,"featured_image":"https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/a7f1c670-d0b1-4dd5-b4b8-d1a2ba3369ab-1785160731434.png"},{"id":"be3dc954-7014-4179-bdd1-727738aed6db","sku":"5016301007","brand":"EcoFlow","category":"Power Stations","subcategory":null,"name":"EcoFlow DELTA 3","slug":"delta-3","description":"The EcoFlow DELTA 3 brings next-generation LFP technology to the 1024Wh class. With 1800W output, UPS functionality, and 3600W surge capacity, it handles virtually any appliance.","specs":{"usb_a":"2 x USB-A 18W","usb_c":"2 x USB-C 100W","weight":"12.5kg (27.6 lbs)","x_boost":"2200W","capacity":"1024Wh","car_port":"1 x 126W","ups_mode":"Yes (<30ms switchover)","warranty":"24 months","ac_output":"1800W (Surge 3600W)","dc_output":"2 x DC5521 12.6V 3A","ac_outlets":"6 AC outlets","cycle_life":"3500+ cycles to 80%","dimensions":"398 x 202 x 284mm","expandable":"Yes — up to 5kWh","ac_charging":"1500W Max, 0-80% in 60 mins","app_control":"Yes (Wi-Fi & Bluetooth)","solar_input":"500W Max (11-60V, 15A)","total_ports":"13","battery_type":"LFP (LiFePO4)"},"images":["/products/ecoflow/delta-3.jpg"],"price_kes":99980,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":10,"featured":true,"sort_order":5,"meta_title":"Buy EcoFlow DELTA 3 in Kenya — Price KES 99,980 | Batteriq","meta_description":"Buy the EcoFlow DELTA 3 in Kenya for KES 99,980. 1024Wh LFP, 1800W AC output, UPS function. Authorised EcoFlow dealer. M-Pesa payment. Nairobi delivery.","schema_rating":4.7,"schema_review_count":143,"created_at":"2026-05-19T11:44:02.890651+00:00","updated_at":"2026-08-21T03:25:38.91826+00:00","discount_label":null,"discount_start":null,"discount_end":null,"low_stock_threshold":3,"featured_image":"/products/ecoflow/delta-3.jpg"},{"id":"26b1ab72-7abf-4bd7-94b4-049515ba4bc2","sku":"5016201005","brand":"EcoFlow","category":"Power Stations","subcategory":null,"name":"EcoFlow DELTA 3 Plus","slug":"delta-3-plus","description":"The EcoFlow DELTA 3 Plus takes the DELTA 3 further with enhanced capacity, faster charging, and superior power management. The benchmark mid-range power station in Kenya.","specs":{"usb_a":"2 x USB-A 36W","usb_c":"2 x USB-C 140W","weight":"16.5kg (36.4 lbs)","x_boost":"2600W","capacity":"1024Wh","ups_mode":"Yes (<30ms switchover)","warranty":"24 months","ac_output":"1800W (Surge 3600W)","cycle_life":"3500+ cycles to 80%","dimensions":"398 x 202 x 284mm","expandable":"Yes — up to 5kWh","ac_charging":"1500W Max, 0-100% in 56 mins","app_control":"Yes (Wi-Fi & Bluetooth)","solar_input":"1000W Max (Dual 500W MPPT ports)","battery_type":"LFP (LiFePO4)"},"images":["https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/26b1ab72-7abf-4bd7-94b4-049515ba4bc2-1785490680813.jpg"],"price_kes":112475,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":10,"featured":true,"sort_order":6,"meta_title":"EcoFlow DELTA 3 Plus Kenya — KES 112,475 | Batteriq","meta_description":"Buy the EcoFlow DELTA 3 Plus in Kenya for KES 112,475. 1024Wh LFP, 1800W AC, UPS, upgraded. Authorised EcoFlow dealer. M-Pesa payment. Nairobi delivery.","schema_rating":4.9,"schema_review_count":14,"created_at":"2026-05-19T11:44:02.890651+00:00","updated_at":"2026-08-21T03:25:36.27407+00:00","discount_label":null,"discount_start":null,"discount_end":null,"low_stock_threshold":3,"featured_image":"https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/26b1ab72-7abf-4bd7-94b4-049515ba4bc2-1785490680813.jpg"},{"id":"fallback-delta-3-1000-air","sku":"EFD3A1000-UK","brand":"EcoFlow","category":"Power Stations","subcategory":"DELTA Series","name":"EcoFlow DELTA 3 1000 Air","slug":"delta-3-1000-air","description":"The EcoFlow DELTA 3 1000 Air is a compact, lightweight 960Wh LiFePO4 portable power station built for Kenyan homes, apartments, remote work and everyday outage backup. Delivering 500W pure sine wave AC output (expandable to 1000W with X-Boost), it keeps Wi‑Fi routers, laptops, TVs, lighting and small appliances running reliably during blackouts.","specs":{"capacity":"960Wh","ac_output":"500W (Expandable to 1000W with X-Boost)","x_boost":"1000W","chemistry":"LFP (LiFePO4)","battery_life":"3000+ cycles to 80%","ups_mode":"Yes","warranty":"24 months"},"images":["/products/ecoflow/delta-3-100-air.png"],"price_kes":54065,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":10,"featured":false,"sort_order":9,"meta_title":"EcoFlow DELTA 3 1000 Air Kenya — 960Wh | 500W (1000W X-Boost) KES 54,065 | Batteriq","meta_description":"Buy the EcoFlow DELTA 3 1000 Air in Kenya for KES 54,065. 960Wh LFP capacity, 500W AC output expandable to 1000W with X-Boost. Authorised EcoFlow dealer. M-Pesa checkout.","schema_rating":0,"schema_review_count":0,"created_at":"2026-10-02T00:00:00.000Z","updated_at":"2026-10-02T00:00:00.000Z"},{"id":"d892c8b9-4750-4bb8-87ac-ecb6dc24b4d3","sku":"5025901009","brand":"EcoFlow","category":"Power Stations","subcategory":"DELTA Series","name":"EcoFlow DELTA 3 Classic","slug":"delta-3-classic","description":"The EcoFlow DELTA 3 Classic is EcoFlow’s best-value 1kWh portable power station for Kenyan homes, outdoor work and everyday backup. With 1024Wh LiFePO4 capacity and 1800W AC output (3600W surge, X-Boost to 2400W), it powers essentials like lights, Wi‑Fi, TVs, fridges and power tools. Charges 0–80% in 45 mins via 1400W AC, 500W solar max, 10ms UPS switchover, 5 outlets, whisper-quiet 30dB operation.","specs":{"capacity":"1024Wh","ac_output":"1800W (Surge 3600W)","x_boost":"2400W","chemistry":"LFP (LiFePO4)","battery_life":"4000 cycles to 80%","solar_input":"500W Max","ac_charging":"1400W (0-80% in 45 mins)","ups_mode":"Yes (10ms switchover)","outlets":"5","weight":"12.1kg","dimensions":"398 x 200 x 283mm","expandable":"No","warranty":"24 months"},"images":["/products/ecoflow/delta-3-classic.png"],"price_kes":84379,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":10,"featured":false,"sort_order":10,"meta_title":"EcoFlow DELTA 3 Classic Kenya — 1024Wh KES 84,379 | Batteriq","meta_description":"Buy the EcoFlow DELTA 3 Classic in Kenya for KES 84,379. 1024Wh LFP, 1800W AC output, 10ms UPS. Authorised EcoFlow dealer. M-Pesa checkout. 24-month warranty.","schema_rating":0,"schema_review_count":0,"created_at":"2026-10-02T00:00:00.000Z","updated_at":"2026-10-02T00:00:00.000Z"},{"id":"fallback-delta-3-2000-air","sku":"EFD3A2000-UK","brand":"EcoFlow","category":"Power Stations","subcategory":"DELTA Series","name":"EcoFlow DELTA 3 2000 Air (EFD3A2000-UK)","slug":"delta-3-2000-air","description":"The EcoFlow DELTA 3 2000 Air (EFD3A2000-UK) packs a massive 1920Wh LiFePO4 battery with a 1000W pure sine wave AC inverter for long-runtime backup in Kenyan homes and offices. Ideal for powering fridges, TVs, workstations, lighting and internet routers through extended grid outages.","specs":{"capacity":"1920Wh","ac_output":"1000W","model_number":"EFD3A2000-UK","chemistry":"LFP (LiFePO4)","battery_life":"3000+ cycles to 80%","ups_mode":"Yes","warranty":"24 months"},"images":["/products/ecoflow/delta-3-2000-air.jpg"],"price_kes":106725,"compare_price_kes":null,"discount_percent":null,"discount_badge":null,"in_stock":true,"stock_qty":10,"featured":false,"sort_order":10,"meta_title":"EcoFlow DELTA 3 2000 Air (EFD3A2000-UK) Kenya — 1920Wh 1000W KES 106,725 | Batteriq","meta_description":"Buy the EcoFlow DELTA 3 2000 Air (EFD3A2000-UK) in Kenya for KES 106,725. 1920Wh LFP capacity, 1000W AC output. Authorised EcoFlow dealer. M-Pesa checkout.","schema_rating":0,"schema_review_count":0,"created_at":"2026-10-02T00:00:00.000Z","updated_at":"2026-10-02T00:00:00.000Z"},{"id":"9c3fb887-4fa9-4110-8e32-60aa862c4d6c","sku":"5005501028","brand":"EcoFlow","category":"Power Stations","subcategory":null,"name":"EcoFlow RIVER 2 Pro","slug":"river-2-pro","description":"The EcoFlow RIVER 2 Pro is the most capable RIVER series power station with 768Wh capacity and 800W AC output. Supports X-Boost technology for powering high-wattage devices.","specs":{"usb_a":"2 x USB-A 12W","usb_c":"1 x USB-C 100W","weight":"7.8kg","capacity":"768Wh","warranty":"24 months","ac_output":"800W (Surge 1600W)","cycle_life":"3000+ cycles","ac_charging":"940W Max","app_control":"Yes (Wi-Fi & Bluetooth)","solar_input":"220W Max (11-50V, 13A)","battery_type":"LFP"},"images":["https://ueagjjdbbukdkktviyrv.supabase.co/storage/v1/object/public/product-images/products/9c3fb887-4fa9-4110-8e32-60aa862c4d6c-1780069789344